print("PROYECCION 2026-2031 (+1°C POR CIUDAD)")
print("")

años_futuros = list(range(2026, 2032))
incremento_anual = 1.0 / 6

ultimo_año = max(df_completo['Año'])
temp_base_ciudad = df_completo[df_completo['Año'] == ultimo_año].groupby('ciudad')['temperature_2m_mean'].mean()

print(f"Temperatura base por ciudad (año {ultimo_año}):")
for ciudad, temp in temp_base_ciudad.items():
    print(f"  {ciudad}: {temp:.1f}°C")

# Proyeccion
resultados_ciudad = []

for año in años_futuros:
    años_desde_base = año - ultimo_año
    delta_temp = años_desde_base * incremento_anual
    delta_temp = max(0, min(1.0, delta_temp))
    
    for ciudad in df_completo['ciudad'].unique():
        df_ciudad = df_completo[df_completo['ciudad'] == ciudad].copy()
        
        df_ciudad['temperature_2m_mean'] = df_ciudad['temperature_2m_mean'] + delta_temp
        df_ciudad['riesgo_total'] = df_ciudad.apply(
            lambda row: calcular_riesgo_total(row['temperature_2m_mean'], row['relative_humidity_2m_mean']), 
            axis=1
        )
        df_ciudad['anomalia_temp'] = df_ciudad['temperature_2m_mean'] - df_ciudad['temp_media_historica']
        df_ciudad['Matriz_enc'] = le_matriz.transform(df_ciudad['Matriz'])
        df_ciudad['ciudad_enc'] = le_ciudad.transform(df_ciudad['ciudad'])
        
        X_futuro = df_ciudad[predictores].copy()
        proba = rf.predict_proba(X_futuro)[:, 1]
        
        resultados_ciudad.append({
            'Año': año,
            'ciudad': ciudad,
            'delta_temp': delta_temp,
            'probabilidad_promedio': proba.mean(),
            'temp_promedio': df_ciudad['temperature_2m_mean'].mean(),
            'humedad_promedio': df_ciudad['relative_humidity_2m_mean'].mean(),
            'contaminacion_estimada': (proba > 0.5).mean()
        })

df_resultados = pd.DataFrame(resultados_ciudad)

