    'T-2/HT-2  (ppb)': 'T2_HT2',
    'OTA  (ppb)': 'OTA'
}

def calcular_factor_riesgo_temp(temp_actual, toxina):
    """Calcula el factor de riesgo por temperatura"""
    if toxina not in TEMP_OPTIMA:
        return 0
    info = TEMP_OPTIMA[toxina]
    t_min, t_max, t_opt = info['min'], info['max'], info['optima']
    if t_min <= temp_actual <= t_max:
        distancia_optimo = abs(temp_actual - t_opt)
        rango = (t_max - t_min) / 2
        return max(0.3, 1 - (distancia_optimo / rango))
    else:
        return 0.1

def calcular_factor_riesgo_humedad(humedad_actual, toxina):
    """Calcula el factor de riesgo por humedad"""
    if toxina not in HUMEDAD_OPTIMA:
        return 0
    info = HUMEDAD_OPTIMA[toxina]
    h_min, h_max, h_opt = info['min'], info['max'], info['optima']
    
    if humedad_actual < h_min:
        return max(0.1, 0.3 * (humedad_actual / h_min))
    elif h_min <= humedad_actual <= h_max:
        distancia_optimo = abs(humedad_actual - h_opt)
        rango = (h_max - h_min) / 2
        return max(0.5, 1 - (distancia_optimo / rango))
    else:
        return max(0.2, 0.5 * (h_max / humedad_actual))

def calcular_riesgo_total(temp_actual, humedad_actual):
    """Riesgo combinado temperatura + humedad"""
    riesgos = []
    for toxina in TEMP_OPTIMA.keys():
        riesgo_temp = calcular_factor_riesgo_temp(temp_actual, toxina)
        riesgo_humedad = calcular_factor_riesgo_humedad(humedad_actual, toxina)
        riesgo_combinado = np.sqrt(riesgo_temp * riesgo_humedad)
        riesgos.append(riesgo_combinado)
    return np.mean(riesgos)

def esta_contaminado(valor):
    """Determina si una muestra esta contaminada"""
    if pd.isna(valor) or valor == "":
        return 0
    valor_str = str(valor).strip()
    if valor_str.startswith('<'):
        return 0
    if valor_str.startswith('>'):
        return 1
    try:
        float(valor_str.replace(',', '.'))
        return 1
    except:
        return 0

def asignar_ciudad(matriz):
    """Asigna ciudad basada en la matriz alimenticia"""
    matriz = str(matriz).upper().strip()
    if 'TORTA DE PALMISTE' in matriz:
        return 'Pucallpa'
    elif 'TRIGO' in matriz or 'POLVILLO' in matriz:
        return 'Cusco'
    elif 'MAIZ' in matriz:
        return 'Trujillo'
    elif 'ARROCILLO' in matriz:
        return 'Iquitos'
    elif 'SOJA' in matriz:
        return 'Lima'
    else:
        return 'Lima'


# 2. Cargar datos
print("CARGANDO DATOS")
print("")

df_micotoxinas = pd.read_excel('datos Peru micotoxinas.xlsx')
