    'T2_HT2': {'min': 20, 'max': 25, 'optima': 20, 'hongo': 'Fusarium langsethiae'},
    'OTA':    {'min': 25, 'max': 30, 'optima': 28, 'hongo': 'Aspergillus ochraceus'},
}

HUMEDAD_OPTIMA = {
    'AFB1':   {'min': 88,  'max': 90,  'optima': 89.0, 'nota': 'Alta humedad favorece Aspergillus'},
    'FUM':    {'min': 85,  'max': 95,  'optima': 90.0, 'nota': 'Humedad moderada-alta'},
    'DON':    {'min': 95,  'max': 100, 'optima': 98.0, 'nota': 'Humedad muy alta'},
    'ZEN':    {'min': 91,  'max': 98,  'optima': 94.5, 'nota': 'Humedad alta'},
    'T2_HT2': {'min': 93, 'max': 99,  'optima': 96.0, 'nota': 'Humedad muy alta'},
    'OTA':    {'min': 95,  'max': 100, 'optima': 98.0, 'nota': 'Humedad extremadamente alta'},
}


def calcular_factor_riesgo_temp(temp_actual, toxina):
    """Calcula el factor de riesgo por temperatura para una toxina específica."""
    if toxina not in TEMP_OPTIMA:
        return 0.0
    info = TEMP_OPTIMA[toxina]
    t_min, t_max, t_opt = info['min'], info['max'], info['optima']
    if t_min <= temp_actual <= t_max:
        distancia_optimo = abs(temp_actual - t_opt)
        rango = (t_max - t_min) / 2
        return max(0.3, 1 - (distancia_optimo / rango))
    return 0.1


def calcular_factor_riesgo_humedad(humedad_actual, toxina):
    """Calcula el factor de riesgo por humedad para una toxina específica."""
    if toxina not in HUMEDAD_OPTIMA:
        return 0.0
    info = HUMEDAD_OPTIMA[toxina]
    h_min, h_max, h_opt = info['min'], info['max'], info['optima']
    if humedad_actual < h_min:
        return max(0.1, 0.3 * (humedad_actual / h_min))
    elif h_min <= humedad_actual <= h_max:
        distancia_optimo = abs(humedad_actual - h_opt)
        rango = (h_max - h_min) / 2
        # CORRECCIÓN: evitar división por cero cuando h_min == h_max
        if rango == 0:
            return 1.0
        return max(0.5, 1 - (distancia_optimo / rango))
    return max(0.2, 0.5 * (h_max / humedad_actual))


def calcular_riesgo_total(temp_actual, humedad_actual):
    """Calcula el riesgo total combinando temperatura y humedad para todas las toxinas."""
    riesgos = []
    for toxina in TEMP_OPTIMA:
        riesgo_temp    = calcular_factor_riesgo_temp(temp_actual, toxina)
        riesgo_humedad = calcular_factor_riesgo_humedad(humedad_actual, toxina)
        riesgos.append(np.sqrt(riesgo_temp * riesgo_humedad))
    return float(np.mean(riesgos))


def esta_contaminado(valor):
    """Determina si una muestra está contaminada basada en el valor de micotoxina."""
    if pd.isna(valor) or valor == "":
        return 0
    valor_str = str(valor).strip()
    if valor_str.startswith('<'):
        return 0
    if valor_str.startswith('>'):
        return 1
    try:
        float(valor_str.replace(',', '.'))
        return 1
    except ValueError:
        return 0


def asignar_ciudad(matriz):
    """Asigna una ciudad basada en el tipo de matriz alimenticia."""
    matriz = str(matriz).upper().strip()
    if 'TORTA DE PALMISTE' in matriz:
        return 'Pucallpa'
    elif 'TRIGO' in matriz or 'POLVILLO' in matriz:
        return 'Cusco'
    elif 'MAIZ' in matriz:
        return 'Trujillo'
    elif 'ARROCILLO' in matriz:
        return 'Iquitos'
    elif 'SOJA' in matriz:
        return 'Lima'
    else:
        return 'Lima'


