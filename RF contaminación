# ── 12. Preparar datos para el modelo ─────────────────────────────────────────
print("\nPreparando datos para el modelo")

TODAS_CIUDADES = df_completo['ciudad'].unique().tolist()

le_ciudad  = LabelEncoder().fit(TODAS_CIUDADES)
le_matriz  = LabelEncoder().fit(df_completo['Matriz'].unique())

df_completo['Matriz_enc'] = le_matriz.transform(df_completo['Matriz'])
df_completo['ciudad_enc'] = le_ciudad.transform(df_completo['ciudad'])

predictores = ['Matriz_enc', 'ciudad_enc',
               'temperature_2m_mean', 'relative_humidity_2m_mean', 'riesgo_total']

X = df_completo[predictores].copy()
y = df_completo['contaminada'].copy()

# CORRECCIÓN: verificar que hay al menos dos clases antes de entrenar
if y.nunique() < 2:
    raise ValueError("La variable objetivo solo tiene una clase; no se puede entrenar el clasificador.")


# ── 13. División entrenamiento / prueba ───────────────────────────────────────
print("\nDividiendo datos (70% entrenamiento, 30% prueba)...")

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.3, random_state=42, stratify=y
)

print(f"Entrenamiento: {X_train.shape[0]} muestras "
      f"({X_train.shape[0]/len(df_completo)*100:.0f}%)")
print(f"  - Proporción contaminadas: {y_train.mean():.1%}")
print(f"Prueba: {X_test.shape[0]} muestras "
      f"({X_test.shape[0]/len(df_completo)*100:.0f}%)")
print(f"  - Proporción contaminadas: {y_test.mean():.1%}")


# ── 14. Entrenar modelo Random Forest ─────────────────────────────────────────
print("Entrenando modelo Random Forest")

rf = RandomForestClassifier(
    n_estimators=200,
    max_depth=8,
    min_samples_split=10,
    random_state=42,
)
rf.fit(X_train, y_train)

# CORRECCIÓN: n_splits no puede superar el mínimo de muestras por clase
min_class_count = y_train.value_counts().min()
n_splits = min(5, min_class_count)
cv = StratifiedKFold(n_splits=n_splits, shuffle=True, random_state=42)

cv_scores   = cross_val_score(rf, X_train, y_train, cv=cv, scoring='roc_auc')
y_cv_proba  = cross_val_predict(rf, X_train, y_train, cv=cv, method='predict_proba')[:, 1]

r2_cv   = r2_score(y_train, y_cv_proba)
rmse_cv = np.sqrt(mean_squared_error(y_train, y_cv_proba))

print(f"Validación cruzada ({n_splits} folds) AUC-ROC: "
      f"media = {cv_scores.mean():.3f} (+/- {cv_scores.std():.3f})")
print(f"  R2 (CV):   {r2_cv:.3f}")
print(f"  RMSE (CV): {rmse_cv:.3f}")

y_train_pred  = rf.predict(X_train)
y_train_proba = rf.predict_proba(X_train)[:, 1]
y_test_pred   = rf.predict(X_test)
y_test_proba  = rf.predict_proba(X_test)[:, 1]

r2_train   = r2_score(y_train, y_train_proba)
rmse_train = np.sqrt(mean_squared_error(y_train, y_train_proba))

print(f"Rendimiento en entrenamiento:")
print(f"  Accuracy: {accuracy_score(y_train, y_train_pred):.3f}")
print(f"  AUC-ROC:  {roc_auc_score(y_train, y_train_proba):.3f}")
print(f"  R2:       {r2_train:.3f}")
print(f"  RMSE:     {rmse_train:.3f}")

print(f"Rendimiento en prueba:")
print(f"  Accuracy: {accuracy_score(y_test, y_test_pred):.3f}")
print(f"  AUC-ROC:  {roc_auc_score(y_test, y_test_proba):.3f}")

print("Importancia de variables:")
for var, imp in zip(predictores, rf.feature_importances_):
    print(f"  {var}: {imp:.3f}")


# ── 15. Proyección por ciudad (+1 °C para 2031) ────────────────────────────────
print("\n=== PROYECCIÓN POR CIUDAD 2026-2031 (+1°C) ===")

años_futuros    = list(range(2026, 2032))
incremento_anual = 1.0 / 6
resultados_por_ciudad = []

for año in años_futuros:
    años_desde_base = año - 2025
    delta_temp = min(1.0, años_desde_base * incremento_anual)

    for ciudad in df_completo['ciudad'].unique():
        df_c = df_completo[df_completo['ciudad'] == ciudad].copy()
        df_c['temperature_2m_mean'] += delta_temp
        df_c['riesgo_total'] = df_c.apply(
            lambda row: calcular_riesgo_total(row['temperature_2m_mean'],
                                              row['relative_humidity_2m_mean']),
            axis=1,
        )
        df_c['Matriz_enc'] = le_matriz.transform(df_c['Matriz'])
        df_c['ciudad_enc'] = le_ciudad.transform(df_c['ciudad'])

        proba = rf.predict_proba(df_c[predictores])[:, 1]
        resultados_por_ciudad.append({
            'Año':                    año,
            'ciudad':                 ciudad,
            'delta_temp':             delta_temp,
            'contaminacion_estimada': (proba > 0.5).mean(),
