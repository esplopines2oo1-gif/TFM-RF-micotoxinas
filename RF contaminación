    'OTA': {'min': 25, 'max': 30, 'optima': 25, 'hongo': 'Aspergillus ochraceus'}
}

# Humedades optimas para cada micotoxina (en %)
HUMEDAD_OPTIMA = {
    'AFB1': {'min': 88, 'max': 90, 'optima': 89, 'nota': 'Alta humedad favorece Aspergillus'},
    'FUM': {'min': 89, 'max': 93, 'optima': 90, 'nota': 'Humedad moderada-alta'},
    'DON': {'min': 93, 'max': 95, 'optima': 94, 'nota': 'Humedad muy alta'},
    'ZEN': {'min': 98, 'max': 99, 'optima': 99, 'nota': 'Humedad alta'},
    'T2_HT2': {'min': 98, 'max': 99, 'optima': 98, 'nota': 'Humedad muy alta'},
    'OTA': {'min': 97, 'max': 100, 'optima': 98, 'nota': 'Humedad extremadamente alta'}
}

# Nombres cortos para micotoxinas
nombres_cortos = {
    'AFB1 (ppb)': 'AFB1',
    'FUM  (ppb)': 'FUM',
