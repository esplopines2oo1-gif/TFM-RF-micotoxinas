                             accuracy_score, r2_score, mean_squared_error,
                             precision_recall_curve, average_precision_score,
                             classification_report)
import matplotlib.pyplot as plt
import seaborn as sns
import warnings
warnings.filterwarnings('ignore')

try:
    plt.style.use('ggplot')
except Exception:
    pass
sns.set_palette("Set2")
plt.rcParams['figure.figsize'] = (12, 8)
plt.rcParams['font.size'] = 10


#   1. Constantes biológicas                          ─

TEMP_OPTIMA = {
    'AFB1':   {'min': 25, 'max': 35, 'optima': 33, 'hongo': 'Aspergillus flavus'},
    'FUM':    {'min': 25, 'max': 30, 'optima': 30, 'hongo': 'Fusarium verticillioides'},
    'DON':    {'min': 20, 'max': 25, 'optima': 23, 'hongo': 'Fusarium graminearum'},
    'ZEN':    {'min': 20, 'max': 25, 'optima': 25, 'hongo': 'Fusarium graminearum'},
    'T2_HT2': {'min': 20, 'max': 25, 'optima': 20, 'hongo': 'Fusarium langsethiae'},
    'OTA':    {'min': 25, 'max': 30, 'optima': 28, 'hongo': 'Aspergillus ochraceus'},
}

HUMEDAD_OPTIMA = {
    'AFB1':   {'min': 88,  'max': 90,  'optima': 89.0},
    'FUM':    {'min': 85,  'max': 95,  'optima': 90.0},
    'DON':    {'min': 95,  'max': 100, 'optima': 98.0},
    'ZEN':    {'min': 91,  'max': 98,  'optima': 94.5},
    'T2_HT2': {'min': 93,  'max': 99,  'optima': 96.0},
    'OTA':    {'min': 95,  'max': 100, 'optima': 98.0},
}

COLS_CLIMA = ['temperature_2m_mean', 'temperature_2m_max',
              'relative_humidity_2m_mean', 'precipitation_sum']

MESES_A_NUM = {
    'Enero': 1, 'Febrero': 2, 'Marzo': 3, 'Abril': 4,
    'Mayo': 5, 'Junio': 6, 'Julio': 7, 'Agosto': 8,
    'Septiembre': 9, 'Octubre': 10, 'Noviembre': 11, 'Diciembre': 12,
}
NUM_A_MES = {v: k for k, v in MESES_A_NUM.items()}
ORDEN_MESES = list(MESES_A_NUM.keys())


#   2. Funciones auxiliares                           

def calcular_factor_riesgo_temp(temp_actual, toxina):
    if toxina not in TEMP_OPTIMA or pd.isna(temp_actual):
        return 0.0
    info = TEMP_OPTIMA[toxina]
    t_min, t_max, t_opt = info['min'], info['max'], info['optima']
    if t_min <= temp_actual <= t_max:
        rango = (t_max - t_min) / 2
        return max(0.3, 1 - abs(temp_actual - t_opt) / rango) if rango else 1.0
    return 0.1


def calcular_factor_riesgo_humedad(humedad_actual, toxina):
    if toxina not in HUMEDAD_OPTIMA or pd.isna(humedad_actual):
        return 0.0
    info = HUMEDAD_OPTIMA[toxina]
    h_min, h_max, h_opt = info['min'], info['max'], info['optima']
    if humedad_actual < h_min:
        return max(0.1, 0.3 * (humedad_actual / h_min))
    elif h_min <= humedad_actual <= h_max:
        rango = (h_max - h_min) / 2
        if rango == 0:
            return 1.0                              # CORRECCIÓN: evitar /0
        return max(0.5, 1 - abs(humedad_actual - h_opt) / rango)
    return max(0.2, 0.5 * (h_max / humedad_actual))


def calcular_riesgo_total(temp_actual, humedad_actual):
    riesgos = []
    for toxina in TEMP_OPTIMA:
        rt = calcular_factor_riesgo_temp(temp_actual, toxina)
        rh = calcular_factor_riesgo_humedad(humedad_actual, toxina)
        riesgos.append(np.sqrt(rt * rh))
    return float(np.mean(riesgos))


def esta_contaminado(valor):
    if pd.isna(valor) or valor == "":
        return 0
    s = str(valor).strip()
    if s.startswith('<'):
        return 0
    if s.startswith('>'):
        return 1
    try:
        float(s.replace(',', '.'))
        return 1
    except ValueError:
        return 0


def asignar_ciudad(matriz):
    m = str(matriz).upper().strip()
    if 'TORTA DE PALMISTE' in m:  return 'Pucallpa'
    if 'TRIGO' in m or 'POLVILLO' in m: return 'Cusco'
    if 'MAIZ' in m:               return 'Trujillo'
    if 'ARROCILLO' in m:          return 'Iquitos'
    if 'SOJA' in m:               return 'Lima'
    return 'Lima'


#   3. Cargar datos                               
print("Cargando datos")

df_micotoxinas = pd.read_excel('datos Peru micotoxinas.xlsx')
df_clima       = pd.read_excel('detalle por ubicacion.xlsx')

print(f"  Micotoxinas : {df_micotoxinas.shape[0]} filas")
print(f"  Clima       : {df_clima.shape[0]} filas")


#   4. Procesar micotoxinas                           
print("Procesando datos de micotoxinas")

df_micotoxinas.columns = df_micotoxinas.columns.str.strip()

# CORRECCIÓN: astype(str) antes de strip para evitar crash con NaN
if 'Mes' in df_micotoxinas.columns:
    df_micotoxinas['Mes'] = df_micotoxinas['Mes'].astype(str).str.strip()

if 'Año' in df_micotoxinas.columns:
    print(f"  Años: {sorted(df_micotoxinas['Año'].dropna().unique())}")

micotoxinas    = ['AFB1 (ppb)', 'FUM  (ppb)', 'DON  (ppb)',
                  'ZEN  (ppb)', 'T-2/HT-2  (ppb)', 'OTA  (ppb)']
nombres_cortos = {
    'AFB1 (ppb)': 'AFB1', 'FUM  (ppb)': 'FUM', 'DON  (ppb)': 'DON',
    'ZEN  (ppb)': 'ZEN', 'T-2/HT-2  (ppb)': 'T2_HT2', 'OTA  (ppb)': 'OTA',
}

# Solo columnas presentes
micotoxinas_ok = [m for m in micotoxinas if m in df_micotoxinas.columns]
if not micotoxinas_ok:
    raise ValueError("No se encontraron columnas de micotoxinas. Verifica nombres en el Excel.")

for m in micotoxinas_ok:
    df_micotoxinas[f'contam_{m}'] = df_micotoxinas[m].apply(esta_contaminado)

df_micotoxinas['contaminada'] = df_micotoxinas[
    [f'contam_{m}' for m in micotoxinas_ok]
].max(axis=1)

# CORRECCIÓN: verificar que hay dos clases
if df_micotoxinas['contaminada'].nunique() < 2:
    raise ValueError("La variable objetivo tiene una sola clase. Revisa los datos.")

print(f"  Contaminadas: {df_micotoxinas['contaminada'].sum()} "
      f"de {len(df_micotoxinas)} ({df_micotoxinas['contaminada'].mean():.1%})")

df_micotoxinas['ciudad'] = df_micotoxinas['Matriz'].apply(asignar_ciudad)


#   5. Procesar clima                              
print("Procesando datos climáticos")

df_clima.columns = df_clima.columns.str.strip()

for col in COLS_CLIMA:
    if col in df_clima.columns:
        df_clima[col] = (df_clima[col].astype(str)
                         .str.replace(',', '.', regex=False)
                         .pipe(pd.to_numeric, errors='coerce'))

df_clima['date']    = pd.to_datetime(df_clima['date'])
df_clima['Año']     = df_clima['date'].dt.year
df_clima['Mes_num'] = df_clima['date'].dt.month
df_clima['Mes']     = df_clima['Mes_num'].map(NUM_A_MES)

col_loc = next((c for c in ['location', 'ciudad', 'Location']
                if c in df_clima.columns), df_clima.columns[-1])

agg_dict = {c: 'mean' for c in COLS_CLIMA if c in df_clima.columns}
df_clima_agrupado = (
    df_clima.groupby(['Año', 'Mes', col_loc])
    .agg(agg_dict)
    .reset_index()
    .rename(columns={col_loc: 'ciudad'})
)


#   6. Unir y calcular riesgo                          
df_completo = df_micotoxinas.merge(
    df_clima_agrupado, on=['Año', 'Mes', 'ciudad'], how='left'
)
df_completo['Mes_num'] = df_completo['Mes'].map(MESES_A_NUM)

for ciudad in df_completo['ciudad'].unique():
    mask = df_completo['ciudad'] == ciudad
    for col in COLS_CLIMA:
        if col in df_completo.columns:
            media = df_completo.loc[mask, col].mean()
            df_completo.loc[mask & df_completo[col].isna(), col] = media

df_completo['riesgo_total'] = df_completo.apply(
    lambda r: calcular_riesgo_total(r['temperature_2m_mean'],
                                     r['relative_humidity_2m_mean']), axis=1
)

df_completo = df_completo.dropna(
    subset=['temperature_2m_mean', 'relative_humidity_2m_mean', 'contaminada']
)

print(f"  Dataset final: {df_completo.shape[0]} muestras")
print(f"  Ciudades: {df_completo['ciudad'].unique().tolist()}")


#   7. Análisis exploratorio por ciudad                    ─
print("\n=== ANÁLISIS POR CIUDAD ===")

contam_por_ciudad = (
    df_completo.groupby('ciudad')['contaminada']
    .agg(tasa='mean', n='count', n_contam='sum')
    .round(4)
    .sort_values('tasa', ascending=False)
    .reset_index()
)
for _, row in contam_por_ciudad.iterrows():
    print(f"  {row['ciudad']}: {row['tasa']:.1%} "
          f"({row['n_contam']:.0f}/{row['n']:.0f})")

df_evol = (
    df_completo.groupby(['Año', 'Mes_num', 'ciudad'])
    .agg(contaminada=('contaminada', 'mean'),
         temperature_2m_mean=('temperature_2m_mean', 'mean'),
         relative_humidity_2m_mean=('relative_humidity_2m_mean', 'mean'),
         riesgo_total=('riesgo_total', 'mean'))
    .reset_index()
)

# CORRECCIÓN: Mes_num a int antes de construir la fecha
df_evol['Mes_num'] = df_evol['Mes_num'].astype(int)
df_evol['Fecha']   = pd.to_datetime(
    df_evol['Año'].astype(str) + '-' +
    df_evol['Mes_num'].astype(str).str.zfill(2) + '-01'
)


#   8. Gráfico: Evolución temporal por ciudad                 ─
ciudades   = df_evol['ciudad'].unique()
n_ciudades = len(ciudades)
n_cols     = 3
n_rows     = int(np.ceil(n_ciudades / n_cols))

fig, axes = plt.subplots(n_rows, n_cols, figsize=(18, 6 * n_rows))
axes_flat = np.array(axes).flatten()
fig.suptitle('Evolución Temporal de Contaminación por Ciudad',
             fontsize=16, fontweight='bold')

for idx, ciudad in enumerate(ciudades):
    ax  = axes_flat[idx]
    dfc = df_evol[df_evol['ciudad'] == ciudad].sort_values('Fecha')
    ax.plot(dfc['Fecha'], dfc['contaminada'] * 100,
            'o-', linewidth=2, markersize=4, color='steelblue')
    if len(dfc) > 1:
        z = np.polyfit(range(len(dfc)), dfc['contaminada'], 1)
        ax.plot(dfc['Fecha'], np.poly1d(z)(range(len(dfc))) * 100,
                'r--', linewidth=2, label=f'Tendencia: {z[0]*100:+.1f}%/periodo')
    ax.set_title(ciudad, fontsize=12, fontweight='bold')
    ax.set_ylabel('Contaminación (%)')
    ax.set_ylim(0, 100)
    ax.legend(fontsize=8)
    ax.grid(True, alpha=0.3)
    ax.tick_params(axis='x', rotation=45)

# Ocultar subplots sobrantes
for j in range(n_ciudades, len(axes_flat)):
    axes_flat[j].set_visible(False)

plt.tight_layout()
plt.savefig('evolucion_contaminacion_por_ciudad.png', dpi=150, bbox_inches='tight')
plt.show()


#   9. Gráfico: Heatmap ciudad × mes                      
fig, ax = plt.subplots(figsize=(12, 8))

meses_presentes = [m for m in ORDEN_MESES if m in df_completo['Mes'].unique()]
matriz_cm = (
    df_completo.groupby(['ciudad', 'Mes'])['contaminada']
    .mean()
    .unstack()
    .reindex(columns=meses_presentes)   # CORRECCIÓN: solo meses con datos
)

# Añadir anotación de n muestras para advertir celdas con pocos datos
n_matriz = (
    df_completo.groupby(['ciudad', 'Mes'])['contaminada']
    .count()
    .unstack()
    .reindex(columns=meses_presentes)
)
annot_labels = matriz_cm.apply(lambda col: col.map(
    lambda x: f'{x*100:.0f}%' if not pd.isna(x) else ''
))

sns.heatmap(matriz_cm * 100, annot=annot_labels, fmt='',
            cmap='YlOrRd', cbar_kws={'label': 'Tasa Contaminación (%)'},
            ax=ax, linewidths=0.5)
ax.set_title('Mapa de Calor: Contaminación por Ciudad y Mes\n'
             '(celdas grises = sin datos ese mes)',
             fontsize=13, fontweight='bold')
ax.set_xlabel('Mes'); ax.set_ylabel('Ciudad')

plt.tight_layout()
plt.savefig('heatmap_ciudad_mes.png', dpi=150, bbox_inches='tight')
plt.show()


#   10. Gráfico: Condiciones climáticas por ciudad               
fig, axes = plt.subplots(1, 2, figsize=(16, 8))
fig.suptitle('Condiciones Climáticas por Ciudad', fontsize=14, fontweight='bold')

for ax, col, color, xlabel in [
    (axes[0], 'temperature_2m_mean',       'coral',     'Temperatura Promedio (°C)'),
    (axes[1], 'relative_humidity_2m_mean', 'lightblue', 'Humedad Promedio (%)'),
]:
    stats = (df_completo.groupby('ciudad')[col]
             .agg(['mean', 'min', 'max'])
             .sort_values('mean').reset_index())
    ax.barh(stats['ciudad'], stats['mean'], color=color, edgecolor='black')
    ax.errorbar(stats['mean'], stats['ciudad'],
                xerr=[stats['mean'] - stats['min'],
                      stats['max']  - stats['mean']],
                fmt='none', color='black', capsize=5)
    ax.set_xlabel(xlabel, fontsize=12)
    ax.grid(True, alpha=0.3, axis='x')

plt.tight_layout()
plt.savefig('condiciones_climaticas_por_ciudad.png', dpi=150, bbox_inches='tight')
plt.show()


#   11. Correlaciones por ciudad                        ─
print("\n=== CORRELACIONES POR CIUDAD ===")
for ciudad in df_completo['ciudad'].unique():
    dfc = df_completo[df_completo['ciudad'] == ciudad]
    if len(dfc) > 10:
        print(f"\n{ciudad} (n={len(dfc)}):")
        print(f"  Temp-Contaminación:    {dfc['temperature_2m_mean'].corr(dfc['contaminada']):.3f}")
        print(f"  Humedad-Contaminación: {dfc['relative_humidity_2m_mean'].corr(dfc['contaminada']):.3f}")
        print(f"  Riesgo-Contaminación:  {dfc['riesgo_total'].corr(dfc['contaminada']):.3f}")


#   12. Preparar modelo                             
print("\nPreparando datos para el modelo")

le_ciudad = LabelEncoder().fit(df_completo['ciudad'].unique())
le_matriz = LabelEncoder().fit(df_completo['Matriz'].unique())

df_completo['Matriz_enc'] = le_matriz.transform(df_completo['Matriz'])
df_completo['ciudad_enc'] = le_ciudad.transform(df_completo['ciudad'])

predictores = ['Matriz_enc', 'ciudad_enc',
               'temperature_2m_mean', 'relative_humidity_2m_mean', 'riesgo_total']

X = df_completo[predictores].copy()
y = df_completo['contaminada'].copy()


#   13. Split 70/30                               
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.3, random_state=42, stratify=y
)
print(f"  Train: {len(X_train)} ({y_train.mean():.1%} contaminadas)")
print(f"  Test:  {len(X_test)}  ({y_test.mean():.1%} contaminadas)")


#   14. Entrenar RF                               
print("Entrenando Random Forest")

rf = RandomForestClassifier(
    n_estimators=200,
    max_depth=8,
    min_samples_split=10,
    oob_score=True,         # validación OOB gratuita
    random_state=42,
    n_jobs=-1,
)
rf.fit(X_train, y_train)

# CORRECCIÓN: n_splits limitado al mínimo de muestras por clase
min_class = y_train.value_counts().min()
n_splits  = min(5, min_class)
cv        = StratifiedKFold(n_splits=n_splits, shuffle=True, random_state=42)

cv_scores  = cross_val_score(rf, X_train, y_train, cv=cv, scoring='roc_auc')
y_cv_proba = cross_val_predict(rf, X_train, y_train, cv=cv,
                               method='predict_proba')[:, 1]

y_train_pred  = rf.predict(X_train)
y_train_proba = rf.predict_proba(X_train)[:, 1]
y_test_pred   = rf.predict(X_test)
y_test_proba  = rf.predict_proba(X_test)[:, 1]

auc_test = roc_auc_score(y_test, y_test_proba)
ap_test  = average_precision_score(y_test, y_test_proba)

print(f"\nRendimiento en PRUEBA:")
print(f"  Accuracy   : {accuracy_score(y_test, y_test_pred):.3f}")
print(f"  AUC-ROC    : {auc_test:.3f}")
print(f"  Avg Prec.  : {ap_test:.3f}")
print(f"  OOB Score  : {rf.oob_score_:.3f}")
print(f"  CV AUC     : {cv_scores.mean():.3f} ± {cv_scores.std():.3f}")
print(f"\n{classification_report(y_test, y_test_pred, target_names=['No contam.','Contam.'])}")

print("Importancia de variables:")
for var, imp in zip(predictores, rf.feature_importances_):
    print(f"  {var}: {imp:.3f}")


#   15. Proyección +1°C 2026-2031                       ─
print("\n=== PROYECCIÓN 2026-2031 (+1°C) ===")

años_futuros     = list(range(2026, 2032))
incremento_total = 1.0 / 6
resultados_ciudad = []

for año in años_futuros:
    delta = min(1.0, (año - 2025) * incremento_total)
    for ciudad in df_completo['ciudad'].unique():
        dfc = df_completo[df_completo['ciudad'] == ciudad].copy()
        dfc['temperature_2m_mean'] += delta
        dfc['riesgo_total'] = dfc.apply(
            lambda r: calcular_riesgo_total(r['temperature_2m_mean'],
                                             r['relative_humidity_2m_mean']), axis=1
        )
        dfc['Matriz_enc'] = le_matriz.transform(dfc['Matriz'])
        dfc['ciudad_enc'] = le_ciudad.transform(dfc['ciudad'])
        proba = rf.predict_proba(dfc[predictores])[:, 1]

        resultados_ciudad.append({
            'Año': año, 'ciudad': ciudad, 'delta_temp': delta,
            'contaminacion_estimada': (proba > 0.5).mean(),
            'probabilidad_promedio':  proba.mean(),      # ← más informativo que el techo
            'temp_promedio':          dfc['temperature_2m_mean'].mean(),
        })

df_res = pd.DataFrame(resultados_ciudad)
res_2031 = df_res[df_res['Año'] == 2031]
actual_ciudad = df_completo.groupby('ciudad')['contaminada'].mean()

print(f"\n{'Ciudad':<12} {'Actual':>8} {'2031 (>0.5)':>12} "
      f"{'Cambio pp':>10} {'Prob. media':>12}")
print("-" * 58)
for _, row in res_2031.iterrows():
    actual = actual_ciudad.get(row['ciudad'], 0)
    cambio = (row['contaminacion_estimada'] - actual) * 100
    print(f"  {row['ciudad']:<10} {actual:>8.1%} {row['contaminacion_estimada']:>12.1%} "
          f"{cambio:>+9.1f}pp {row['probabilidad_promedio']:>12.3f}")


#  16. Gráfico: Proyección – probabilidad media (evita efecto techo) 
fig, axes = plt.subplots(1, 2, figsize=(18, 7))
fig.suptitle('Proyección de Contaminación por Ciudad (2026-2031, +1°C)',
             fontsize=14, fontweight='bold')

ciudades_unicas = df_res['ciudad'].unique()
colores = plt.cm.Set2(np.linspace(0, 1, len(ciudades_unicas)))

for i, ciudad in enumerate(ciudades_unicas):
    dfc = df_res[df_res['ciudad'] == ciudad]

    # Panel izquierdo: % muestras con prob > 0.5
    axes[0].plot(dfc['Año'], dfc['contaminacion_estimada'] * 100,
                 'o-', color=colores[i], linewidth=2, markersize=6, label=ciudad)

    # Panel derecho: probabilidad media (más sensible al cambio climático)
    axes[1].plot(dfc['Año'], dfc['probabilidad_promedio'],
                 'o-', color=colores[i], linewidth=2, markersize=6, label=ciudad)

axes[0].set_title('% Muestras predichas como contaminadas\n(umbral prob > 0.5)')
axes[0].set_ylabel('Contaminación estimada (%)')
axes[0].set_ylim(0, 100)

axes[1].set_title('Probabilidad media de contaminación\n(más sensible al +1°C)')
axes[1].set_ylabel('Probabilidad media')
axes[1].set_ylim(0, 1)

for ax in axes:
    ax.set_xlabel('Año')
    ax.legend(bbox_to_anchor=(1.02, 1), loc='upper left', fontsize=9)
    ax.grid(True, alpha=0.3)

plt.tight_layout()
plt.savefig('proyeccion_contaminacion_por_ciudad.png', dpi=150, bbox_inches='tight')
plt.show()


# 17. Diagnóstico del modelo (gráficas mejoradas) 
fig = plt.figure(figsize=(18, 12))
fig.suptitle('Diagnóstico del Modelo Random Forest',
             fontsize=16, fontweight='bold')

# 17.1 Matriz de confusión
ax1 = plt.subplot(2, 3, 1)
cm  = confusion_matrix(y_test, y_test_pred)
sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', ax=ax1,
            xticklabels=['No contam.', 'Contam.'],
            yticklabels=['No contam.', 'Contam.'])
ax1.set_title('Matriz de Confusión')
ax1.set_xlabel('Predicho'); ax1.set_ylabel('Actual')

# 17.2 Curva ROC
ax2 = plt.subplot(2, 3, 2)
fpr, tpr, _ = roc_curve(y_test, y_test_proba)
ax2.plot(fpr, tpr, 'b-', linewidth=2, label=f'AUC = {auc_test:.3f}')
ax2.plot([0, 1], [0, 1], 'r--', alpha=0.5)
ax2.set_title('Curva ROC')
ax2.set_xlabel('Tasa Falsos Positivos')
ax2.set_ylabel('Tasa Verdaderos Positivos')
ax2.legend()

# 17.3 Precision-Recall (MEJOR que "Actual vs Predicho" para clasificación)
ax3 = plt.subplot(2, 3, 3)
prec, rec, _ = precision_recall_curve(y_test, y_test_proba)
ax3.plot(rec, prec, 'g-', linewidth=2, label=f'AP = {ap_test:.3f}')
