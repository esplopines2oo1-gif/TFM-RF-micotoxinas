# 3. Procesar micotoxinas
print("")
print("PROCESANDO MICOTOXINAS")
print("")

df_micotoxinas.columns = df_micotoxinas.columns.str.strip()
df_micotoxinas['Mes'] = df_micotoxinas['Mes'].str.strip()

# Crear variable contaminada
micotoxinas = ['AFB1 (ppb)', 'FUM  (ppb)', 'DON  (ppb)', 
               'ZEN  (ppb)', 'T-2/HT-2  (ppb)', 'OTA  (ppb)']

for m in micotoxinas:
    df_micotoxinas[f'contam_{m}'] = df_micotoxinas[m].apply(esta_contaminado)

df_micotoxinas['contaminada'] = df_micotoxinas[[f'contam_{m}' for m in micotoxinas]].max(axis=1)
df_micotoxinas['ciudad'] = df_micotoxinas['Matriz'].apply(asignar_ciudad)

print(f"Muestras contaminadas: {df_micotoxinas['contaminada'].sum()} de {len(df_micotoxinas)} ({df_micotoxinas['contaminada'].mean():.1%})")
print(f"Ciudades en micotoxinas: {df_micotoxinas['ciudad'].unique()}")


# 4. Procesar datos climaticos (TEMPERATURAS REALES DESDE EXCEL)
print("")
print("PROCESANDO DATOS CLIMATICOS (DESDE EXCEL)")
print("")

df_clima.columns = df_clima.columns.str.strip()
columnas_num = ['temperature_2m_mean', 'temperature_2m_max', 
                'relative_humidity_2m_mean', 'precipitation_sum']

for col in columnas_num:
    if col in df_clima.columns:
        df_clima[col] = df_clima[col].astype(str).str.replace(',', '.').astype(float)

df_clima['date'] = pd.to_datetime(df_clima['date'])
df_clima['Año'] = df_clima['date'].dt.year
df_clima['Mes_num'] = df_clima['date'].dt.month

meses_num_nombre = {1:'Enero', 2:'Febrero', 3:'Marzo', 4:'Abril', 5:'Mayo', 6:'Junio',
                    7:'Julio', 8:'Agosto', 9:'Septiembre', 10:'Octubre', 11:'Noviembre', 12:'Diciembre'}
df_clima['Mes'] = df_clima['Mes_num'].map(meses_num_nombre)

# Agrupar por año, mes y ciudad
df_clima_agrupado = df_clima.groupby(['Año', 'Mes', 'location']).agg({
    'temperature_2m_mean': 'mean',
    'temperature_2m_max': 'mean',
    'relative_humidity_2m_mean': 'mean',
    'precipitation_sum': 'mean'
}).reset_index()
df_clima_agrupado = df_clima_agrupado.rename(columns={'location': 'ciudad'})

# Calcular estadisticas por ciudad (históricas)
stats_ciudad = df_clima_agrupado.groupby('ciudad').agg({
    'temperature_2m_mean': ['mean', 'std', 'min', 'max'],
    'relative_humidity_2m_mean': ['mean', 'std']
}).round(2)
stats_ciudad.columns = ['temp_media_historica', 'temp_std_historica', 'temp_min_historica', 'temp_max_historica',
                        'humedad_media_historica', 'humedad_std_historica']
stats_ciudad = stats_ciudad.reset_index()

print("Estadisticas climaticas por ciudad (desde Excel):")
print(stats_ciudad.to_string())


# 5. Unir datos
print("")
print("UNIENDO DATOS")
print("")

df_completo = df_micotoxinas.merge(df_clima_agrupado, on=['Año', 'Mes', 'ciudad'], how='left')

# Rellenar valores faltantes
for ciudad in df_completo['ciudad'].unique():
    for col in columnas_num:
        promedio = df_completo[df_completo['ciudad'] == ciudad][col].mean()
        df_completo.loc[(df_completo['ciudad'] == ciudad) & (df_completo[col].isna()), col] = promedio

# Calcular riesgo total
df_completo['riesgo_total'] = df_completo.apply(
    lambda row: calcular_riesgo_total(row['temperature_2m_mean'], row['relative_humidity_2m_mean']), 
    axis=1
)

# Calcular anomalia termica (desviacion de la media historica de la ciudad)
df_completo = df_completo.merge(stats_ciudad, on='ciudad', how='left')
df_completo['anomalia_temp'] = df_completo['temperature_2m_mean'] - df_completo['temp_media_historica']
df_completo['anomalia_humedad'] = df_completo['relative_humidity_2m_mean'] - df_completo['humedad_media_historica']

df_completo = df_completo.dropna(subset=['temperature_2m_mean', 'relative_humidity_2m_mean', 'contaminada'])

print(f"Dataset final: {df_completo.shape[0]} muestras")
print(f"Años disponibles: {sorted(df_completo['Año'].unique())}")
print(f"Meses disponibles: {sorted(df_completo['Mes'].unique())}")


# 6. Preparar datos para el modelo
print("")
print("PREPARANDO MODELO CON VARIABLES POR CIUDAD")
print("")

# Codificar ciudad
le_ciudad = LabelEncoder()
df_completo['ciudad_enc'] = le_ciudad.fit_transform(df_completo['ciudad'])

# Codificar matriz
le_matriz = LabelEncoder()
df_completo['Matriz_enc'] = le_matriz.fit_transform(df_completo['Matriz'])

# VARIABLES PREDICTORAS
predictores = [
    'Matriz_enc',
    'ciudad_enc',
    'temperature_2m_mean',
    'relative_humidity_2m_mean',
    'riesgo_total',
    'anomalia_temp',
    'anomalia_humedad'
]

X = df_completo[predictores].copy()
y = df_completo['contaminada'].copy()

print(f"Predictores: {predictores}")
print(f"Total muestras: {len(X)}")


# 7. Dividir y entrenar
print("")
print("ENTRENANDO RANDOM FOREST")
print("")

X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.3, random_state=42, stratify=y
)

print(f"Entrenamiento: {X_train.shape[0]} muestras ({X_train.shape[0]/len(X)*100:.0f}%)")
print(f"  - Contaminadas: {y_train.mean():.1%}")
print(f"Prueba: {X_test.shape[0]} muestras ({X_test.shape[0]/len(X)*100:.0f}%)")
print(f"  - Contaminadas: {y_test.mean():.1%}")

# Entrenar Random Forest
rf = RandomForestClassifier(
    n_estimators=200,
    max_depth=8,
    min_samples_split=10,
    random_state=42
)

rf.fit(X_train, y_train)

# Validacion cruzada
cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
cv_scores = cross_val_score(rf, X_train, y_train, cv=cv, scoring='roc_auc')
print(f"Validacion cruzada AUC-ROC: {cv_scores.mean():.3f} (+/- {cv_scores.std():.3f})")

# Predicciones
y_test_pred = rf.predict(X_test)
y_test_proba = rf.predict_proba(X_test)[:, 1]
auc_test = roc_auc_score(y_test, y_test_proba)

print("")
print(f"Rendimiento en prueba:")
print(f"  Accuracy: {accuracy_score(y_test, y_test_pred):.3f}")
print(f"  AUC-ROC: {auc_test:.3f}")

print("")
print("Importancia de variables:")
importancias_df = pd.DataFrame({
    'variable': predictores,
    'importancia': rf.feature_importances_
}).sort_values('importancia', ascending=False)

for _, row in importancias_df.iterrows():
    print(f"  {row['variable']}: {row['importancia']:.3f}")


# 8. GRAFICO 1: Error Rate Plot (Error vs Número de Árboles)
print("")
print("GENERANDO GRAFICO 1: ERROR RATE PLOT")
print("")

# Probar diferentes números de árboles
n_estimators_range = [1, 5, 10, 25, 50, 75, 100, 150, 200, 300, 400, 500]
train_errors = []
test_errors = []

for n in n_estimators_range:
    print(f"  Probando con {n} arboles...")
    rf_temp = RandomForestClassifier(n_estimators=n, max_depth=8, min_samples_split=10, random_state=42)
    rf_temp.fit(X_train, y_train)
    
    # Error de entrenamiento
    train_pred = rf_temp.predict(X_train)
    train_error = 1 - accuracy_score(y_train, train_pred)
    train_errors.append(train_error)
    
    # Error de prueba
    test_pred = rf_temp.predict(X_test)
    test_error = 1 - accuracy_score(y_test, test_pred)
    test_errors.append(test_error)

# Grafico de Error Rate
fig, ax = plt.subplots(figsize=(10, 6))
ax.plot(n_estimators_range, train_errors, 'o-', color='blue', linewidth=2, markersize=6, label='Error de entrenamiento')
ax.plot(n_estimators_range, test_errors, 's-', color='red', linewidth=2, markersize=6, label='Error de validacion (prueba)')
ax.axhline(y=min(test_errors), color='green', linestyle='--', alpha=0.7, label=f'Mínimo error: {min(test_errors):.3f}')
ax.set_xlabel('Número de Árboles (n_estimators)', fontsize=12)
ax.set_ylabel('Tasa de Error', fontsize=12)
ax.set_title('Curva de Error vs Número de Árboles (Random Forest)', fontsize=14, fontweight='bold')
ax.legend()
ax.grid(True, alpha=0.3)
# Marcar el punto óptimo
optimo_idx = np.argmin(test_errors)
ax.scatter(n_estimators_range[optimo_idx], test_errors[optimo_idx], color='green', s=150, 
           zorder=5, marker='*', label=f'Óptimo: {n_estimators_range[optimo_idx]} árboles')
ax.legend()
plt.tight_layout()
plt.savefig('1_error_rate_plot.png', dpi=150, bbox_inches='tight')
plt.show()
print("Grafico 1 guardado: '1_error_rate_plot.png'")
print(f"  Número óptimo de árboles: {n_estimators_range[optimo_idx]}")


# 9. GRAFICO 2: Curva ROC (con punto óptimo)
print("")
print("GENERANDO GRAFICO 2: CURVA ROC MEJORADA")
print("")

fig, ax = plt.subplots(figsize=(10, 8))
fpr, tpr, thresholds = roc_curve(y_test, y_test_proba)
auc_test = roc_auc_score(y_test, y_test_proba)

# Calcular el punto óptimo (Youden's J statistic = sensitivity + specificity - 1)
optimal_idx = np.argmax(tpr - fpr)
optimal_threshold = thresholds[optimal_idx]
optimal_fpr = fpr[optimal_idx]
optimal_tpr = tpr[optimal_idx]

# Curva ROC
ax.plot(fpr, tpr, 'b-', linewidth=3, label=f'ROC Curve (AUC = {auc_test:.3f})')
ax.plot([0, 1], [0, 1], 'r--', linewidth=2, alpha=0.5, label='Clasificador aleatorio (AUC = 0.5)')

# Marcar el punto óptimo
ax.scatter(optimal_fpr, optimal_tpr, color='green', s=200, zorder=5, 
           marker='*', edgecolors='black', linewidths=1)
ax.annotate(f'Punto óptimo\nThreshold = {optimal_threshold:.3f}\nTPR = {optimal_tpr:.3f}\nFPR = {optimal_fpr:.3f}', 
            xy=(optimal_fpr, optimal_tpr), xytext=(optimal_fpr + 0.15, optimal_tpr - 0.1),
            fontsize=9, ha='left', va='top',
            bbox=dict(boxstyle='round,pad=0.3', facecolor='yellow', alpha=0.7))

# Rellenar el área bajo la curva
ax.fill_between(fpr, tpr, alpha=0.2, color='blue')

ax.set_xlabel('Tasa de Falsos Positivos (1 - Especificidad)', fontsize=13)
ax.set_ylabel('Tasa de Verdaderos Positivos (Sensibilidad)', fontsize=13)
ax.set_title('Curva ROC - Random Forest', fontsize=15, fontweight='bold')
ax.legend(loc='lower right', fontsize=11)
ax.grid(True, alpha=0.3)
ax.set_xlim([-0.02, 1.02])
ax.set_ylim([-0.02, 1.02])

# Añadir cuadro con métricas
metrics_text = f'AUC = {auc_test:.3f}\nAccuracy = {accuracy_score(y_test, y_test_pred):.3f}\nSensibilidad = {optimal_tpr:.3f}\nEspecificidad = {1-optimal_fpr:.3f}'
ax.text(0.05, 0.05, metrics_text, transform=ax.transAxes, fontsize=10,
        verticalalignment='bottom', bbox=dict(boxstyle='round', facecolor='white', alpha=0.8))

plt.tight_layout()
plt.savefig('2_roc_curve_mejorada.png', dpi=150, bbox_inches='tight')
plt.show()
print("Grafico 2 guardado: '2_roc_curve_mejorada.png'")


